# ========================================================
# ContentFlow AI - Environment Configuration Example
# ========================================================

# LLM Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Web Search Tool Configuration (Tavily AI Search)
TAVILY_API_KEY=your_tavily_api_key_here

# Persistent Storage Database (PostgreSQL)
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=contentflow_db
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/contentflow_db
